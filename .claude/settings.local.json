{
  "enabledMcpjsonServers": ["grafana"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-doc-reminder.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(export:*)",
      "Bash(cd:*)",

      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go tool:*)",
      "Bash(go env:*)",
      "Bash(go list:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",

      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx expo lint:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npx playwright:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm e2e:web:*)",
      "Bash(pnpm exec:*)",

      "Bash(bash ../scripts/check-go-coverage.sh)",
      "Bash(bash ../scripts/check-mobile-coverage.sh)",
      "Bash(bash scripts/check-go-coverage.sh)",
      "Bash(bash scripts/check-mobile-coverage.sh)",
      "Bash(hurl:*)",
      "Bash(sonar-scanner.bat:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(test:*)",
      "Bash(which:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",

      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(go test:*)",
      "PowerShell(npx jest:*)",
      "PowerShell(npx tsc:*)",

      "WebFetch(domain:api.golfcourseapi.com)"
    ]
  }
}
